<?xml version="1.0"?>
<!--
  Mondo "anello" per la versione didattica di GMapping.
  Un corridoio ad anello largo 2.5 m attorno a un blocco centrale (giro di circa 30 m),
  con alcuni elementi disposti in modo non simmetrico perche' ogni tratto sia
  riconoscibile. Serve a osservare la chiusura del ciclo (loop closure).
  Usa solo modelli locali (ground_plane, sun), nessun download.
-->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <scene><shadows>false</shadows></scene>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0 0 16 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <model name="muro_sud">
      <static>true</static>
      <pose>0 -4 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_nord">
      <static>true</static>
      <pose>0 4 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_ovest">
      <static>true</static>
      <pose>-6 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="muro_est">
      <static>true</static>
      <pose>6 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="blocco_centrale">
      <static>true</static>
      <pose>0 0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7 3 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7 3 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cassa_sud">
      <static>true</static>
      <pose>-1.0 -3.6 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="colonna_sud">
      <static>true</static>
      <pose>2.6 -3.55 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="scaffale_est">
      <static>true</static>
      <pose>5.65 -1.2 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 1.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 1.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="angolo_est_a">
      <static>true</static>
      <pose>5.55 2.4 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.7 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.2 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="angolo_est_b">
      <static>true</static>
      <pose>5.3 2.75 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 0.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="colonna_nord_a">
      <static>true</static>
      <pose>2.0 3.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="colonna_nord_b">
      <static>true</static>
      <pose>1.2 3.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual>
      </link>
    </model>
    <model name="panca_nord">
      <static>true</static>
      <pose>-2.5 3.75 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.3 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.3 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="armadio_ovest">
      <static>true</static>
      <pose>-5.6 1.8 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.9 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.9 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
    <model name="sporgenza_blocco">
      <static>true</static>
      <pose>-1.8 1.65 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.3 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.3 0.5</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
